<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="brasa" name="Brasa" version="1.0">
  <color name="canvas" value="#1e2227"/>
  <color name="ink" value="#e1e7ef"/>
  <color name="muted" value="#8995a3"/>
  <color name="line" value="#282f37"/>
  <color name="rule" value="#353e49"/>
  <color name="selected" value="#354a60"/>
  <color name="orange" value="#f0bb8c"/>
  <color name="green" value="#a4d3a6"/>
  <color name="lavender" value="#d3b2ef"/>
  <color name="teal" value="#95d8d4"/>
  <color name="red" value="#ff9388"/>

  <style name="text" foreground="ink" background="canvas"/>
  <style name="selection" foreground="ink" background="selected"/>
  <style name="selection-unfocused" background="rule"/>
  <style name="cursor" foreground="orange"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="muted" background="canvas"/>
  <style name="current-line-number" foreground="orange" background="line"/>
  <style name="bracket-match" foreground="orange" background="rule" bold="true"/>
  <style name="bracket-mismatch" foreground="red" bold="true"/>

  <style name="def:comment" foreground="muted" italic="true"/>
  <style name="def:doc-comment" use-style="def:comment"/>
  <style name="def:constant" foreground="orange"/>
  <style name="def:string" foreground="green"/>
  <style name="def:special-char" foreground="orange"/>
  <style name="def:identifier" foreground="teal"/>
  <style name="def:type" foreground="teal"/>
  <style name="def:keyword" foreground="lavender"/>
  <style name="def:preprocessor" foreground="lavender"/>
  <style name="def:error" foreground="red" underline="error"/>
  <style name="def:warning" foreground="orange"/>
</style-scheme>
